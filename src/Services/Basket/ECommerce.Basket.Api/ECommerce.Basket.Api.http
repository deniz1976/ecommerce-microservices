@ECommerce.Basket.Api_HostAddress = http://localhost:5083
@CustomerId = 11111111-1111-1111-1111-111111111111
@ProductId = 22222222-2222-2222-2222-222222222222

GET {{ECommerce.Basket.Api_HostAddress}}/api/v1/baskets/{{CustomerId}}
Accept: application/json
Accept-Language: en

###

PUT {{ECommerce.Basket.Api_HostAddress}}/api/v1/baskets/{{CustomerId}}/items
Content-Type: application/json
Accept-Language: tr

{
  "productId": "{{ProductId}}",
  "productName": "Sample Product",
  "quantity": 2,
  "unitPrice": 100,
  "currency": "TRY"
}

###

POST {{ECommerce.Basket.Api_HostAddress}}/api/v1/baskets/{{CustomerId}}/checkout
Accept: application/json
Accept-Language: en

###
